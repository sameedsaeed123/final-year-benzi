# =============================================================================
# BENZI API — Example environment (safe to commit)
# =============================================================================
# Copy to .env and adjust:  cp .env.example .env
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
# Must match where Vite runs (include port). Stripe redirects here after checkout.
FRONTEND_URL=http://localhost:5173
# Shown on OpenRouter/API dashboards instead of localhost (optional)
APP_NAME=Benzi
APP_PUBLIC_URL=https://benzi.app
# Optional comma-separated extra origins (e.g. https://app.yoursite.com)
# FRONTEND_URLS=

# Redis (email queue + admin panel read cache). Start: redis-server or docker run -p 6379:6379 redis:7-alpine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# --- HTTP bind (127.0.0.1 dev | 0.0.0.0 Docker/production) ---
LISTEN_HOST=127.0.0.1

# --- MongoDB ---
# Atlas (shared team DB — no local Mongo install):
# Non-SRV — use on Windows or if you see: querySrv ECONNREFUSED _mongodb._tcp...
MONGODB_URI=mongodb://benzi:YOUR_DB_PASSWORD@ac-3x7ttmw-shard-00-00.yiva0kx.mongodb.net:27017,ac-3x7ttmw-shard-00-01.yiva0kx.mongodb.net:27017,ac-3x7ttmw-shard-00-02.yiva0kx.mongodb.net:27017/benzi?ssl=true&replicaSet=atlas-zaynd7-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
# SRV (Mac / normal DNS):
# MONGODB_URI=mongodb+srv://benzi:YOUR_DB_PASSWORD@cluster0.yiva0kx.mongodb.net/benzi?retryWrites=true&w=majority&appName=Cluster0
# Local alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/benzi
# MONGODB_AUTH_SOURCE=admin   # only for self-hosted "root" user, not Atlas
MONGODB_SERVER_SELECTION_MS=25000

# --- JWT (>= 32 chars; use openssl rand -base64 48 in production) ---
JWT_SECRET=DEV_ONLY_benzi_jwt_change_me_use_openssl_rand_hex_64_in_prod
JWT_EXPIRES_IN_REMEMBER=7d
JWT_EXPIRES_IN_SESSION=1h

# --- Seed admin (npm run seed:admin) — benzi-admin panel login ---
SEED_ADMIN_EMAIL=admin@benzi.com
SEED_ADMIN_PASSWORD=admin123

# --- Email Configuration (Gmail SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=BENZI
EMAIL_FROM_ADDRESS=your-email@gmail.com

# --- Redis Configuration (for email queue) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Google Calendar / Meet (therapist OAuth) ---
# Create OAuth Client (Web) and set redirect URI exactly:
#   http://localhost:5000/auth/google/callback
# Option A: paste from Google Cloud → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Also add in Google Console redirect URIs: http://127.0.0.1:5000/auth/google/callback

# Option B: path to downloaded JSON (avoids copy/paste typos — recommended)
# GOOGLE_CREDENTIALS_JSON=/absolute/path/to/client_secret_xxxxx.apps.googleusercontent.com.json

# Anonymous video rooms (Jitsi) — default public instance
# JITSI_BASE_URL=https://meet.jit.si

# Auto-complete CONFIRMED appointments after session end (cron, default every 5 min)
# COMPLETION_CRON_SCHEDULE=*/5 * * * *

# --- BENZI AI ---
# LLM_PROVIDER: openrouter | google | gemini | ollama
# Guides: docs/OLLAMA_SETUP.md · docs/OLLAMA_HARDWARE.md · docs/OLLAMA_FINETUNE_DATASETS.md

# --- Daily dev (fast laptop — no local LLM RAM) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Vision model for therapist-chat image safety (uses OpenRouter, not Gemini)
OPENROUTER_MODERATION_MODEL=openai/gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Local Ollama (Mac 32GB: fast profile | Dell 8GB: same model, keep NUM_CTX=2048) ---
# When not testing AI: npm run ollama:quit  + use openrouter above
# When testing AI:   npm run ollama:start + uncomment block below
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=benzi-finetuned
# OLLAMA_NUM_CTX=2048
# OLLAMA_MAX_TOKENS=220
# OLLAMA_MAX_RECORDS=4
# OLLAMA_RECORD_CHARS=1800
# OLLAMA_HISTORY_MESSAGES=8
# Optional hybrid: OpenRouter summarizes large PDFs once, Ollama still replies
# LLM_HELPER=openrouter
# LLM_HELPER_MIN_CHARS=4500

# Vector RAG (semantic search over PDF chunks — requires ollama pull nomic-embed-text)
# RAG_ENABLED=true
# OLLAMA_EMBED_MODEL=nomic-embed-text
# RAG_TOP_K=5
# RAG_VECTOR_BACKEND=auto
# local | atlas | auto  (auto uses Atlas only on mongodb+srv / .mongodb.net)
# RAG_ATLAS_INDEX=benzi_record_chunks_vector
# npm run ollama:pull-embed && npm run rag:reindex
# Pull base + build: npm run ollama:pull-fast && npm run ollama:build-benzi-finetuned
# Full train pipeline: npm run train:benzi  (from repo root)

# Optional Python DistilBERT sentiment (fyp-ml-demos/sentiment_service.py)
# SENTIMENT_SERVICE_URL=http://127.0.0.1:5001

# --- Stripe (therapist subscriptions) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://your-api.com/api/subscriptions/webhook
