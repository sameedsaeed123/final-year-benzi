# =============================================================================
# BENZI API — Example environment (safe to commit)
# =============================================================================
# Copy to .env and adjust:  cp .env.example .env
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- HTTP bind (127.0.0.1 dev | 0.0.0.0 Docker/production) ---
LISTEN_HOST=127.0.0.1

# --- MongoDB ---
# Local default (no auth):
MONGODB_URI=mongodb://127.0.0.1:27017/benzi
# Remote: database name must be in the PATH before ?options, e.g. ...:PORT/benzi?directConnection=true
# Wrong: ...:PORT/?directConnection=true/benzi
# MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/benzi?directConnection=true
# MONGODB_AUTH_SOURCE=admin
MONGODB_SERVER_SELECTION_MS=25000

# --- JWT (>= 32 chars; use openssl rand -base64 48 in production) ---
JWT_SECRET=DEV_ONLY_benzi_jwt_change_me_use_openssl_rand_hex_64_in_prod
JWT_EXPIRES_IN_REMEMBER=7d
JWT_EXPIRES_IN_SESSION=1h

# --- Seed admin (npm run seed:admin) ---
SEED_ADMIN_EMAIL=admin@benzi.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
