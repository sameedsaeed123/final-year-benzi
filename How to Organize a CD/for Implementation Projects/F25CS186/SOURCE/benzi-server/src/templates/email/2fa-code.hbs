<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your BENZI Verification Code</title>
  <style>
    body { margin:0; padding:0; background:#eef2eb; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; color:#1a2e24; }
    .wrap { max-width:600px; margin:0 auto; background:#ffffff; }
    .header { background:linear-gradient(135deg,#0f3a2b 0%,#1F5F4A 100%); padding:28px 24px; text-align:center; }
    .logo-img { height:42px; width:auto; display:block; margin:0 auto; }
    .tagline { color:rgba(255,255,255,0.85); font-size:12px; margin:14px 0 0; letter-spacing:0.12em; text-transform:uppercase; }
    .hero { background:#f8f7f3; padding:32px 28px 20px; border-bottom:1px solid #e4e8df; }
    .hero h1 { margin:0 0 10px; font-size:24px; color:#0f3a2b; }
    .hero p { margin:0; font-size:15px; line-height:1.65; color:#3d5c4d; }
    .content { padding:28px; }
    .code-display { background:#f8f7f3; border:1px solid #e4e8df; border-left:4px solid #1F5F4A; border-radius:12px; padding:24px; text-align:center; margin:20px 0; }
    .code-label { font-size:12px; text-transform:uppercase; letter-spacing:0.12em; color:#1F5F4A; font-weight:700; margin:0 0 10px; }
    .code-value { font-size:32px; font-weight:bold; color:#0f3a2b; letter-spacing:8px; font-family:'Courier New',monospace; }
    .note { background:#fff8e6; border:1px solid #f0e0b8; border-radius:10px; padding:14px 16px; font-size:13px; color:#6b5a2e; line-height:1.55; margin:18px 0; }
    .sign { font-size:14px; color:#556b5b; line-height:1.6; margin-top:24px; }
    .footer { background:#0f3a2b; color:rgba(255,255,255,0.9); text-align:center; padding:24px 20px; font-size:12px; }
    .footer a { color:#97BFA5; text-decoration:none; margin:0 8px; }
    @media (max-width:600px) {
      .hero, .content { padding:22px 18px; }
      .code-value { font-size:26px; letter-spacing:6px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <img src="{{logoUrl}}" alt="BENZI" class="logo-img" width="140" height="42" style="display:block;margin:0 auto;border:0;height:42px;width:auto;max-width:160px;" />
      <p class="tagline">Mental Health Platform</p>
    </div>

    <div class="hero">
      <h1>Hi {{recipientName}},</h1>
      <p>A two-factor authentication code was requested for your BENZI account.</p>
    </div>

    <div class="content">
      <div class="code-display">
        <p class="code-label">Your Verification Code</p>
        <div class="code-value">{{code}}</div>
      </div>

      <div class="note">
        <strong>⏱️ This code expires in {{expiryMinutes}} minutes.</strong>
      </div>

      <p style="font-size:15px; line-height:1.65; color:#3d5c4d; margin:0 0 16px;">
        Enter this code on the verification page to complete your login. If you didn't request this code, please ignore this email or contact our support team if you have concerns about your account security.
      </p>

      <p class="sign">
        Best regards,<br>
        <strong>The BENZI Team</strong>
      </p>
    </div>

    <div class="footer">
      <p><strong>BENZI</strong> · Mental Health Platform</p>
      <p>&copy; {{currentYear}} BENZI. All rights reserved.</p>
      <p>
        <a href="{{preferencesUrl}}">Email preferences</a>
        <a href="mailto:support@benzi.com">Support</a>
      </p>
    </div>
  </div>
</body>
</html>
