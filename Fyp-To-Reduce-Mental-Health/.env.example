# Dev: leave VITE_API_URL unset so requests go to /api and Vite proxies to the backend.
# Optional: use a friendly local hostname (add to /etc/hosts: 127.0.0.1 benzi.mentalhealth)
# VITE_DEV_HOST=benzi.mentalhealth
# VITE_DEV_PORT=5173
# If the API uses a port other than 5000, set the same value as benzi-server PORT:
# VITE_PROXY_API_PORT=5000
#
# Only set VITE_API_URL when the UI must call the API on another host (then CORS on the API must allow this site).
# VITE_API_URL=http://localhost:5000
#
# Admin panel (separate app) — used for "Admin Panel" links when logged in as admin
# VITE_ADMIN_URL=http://localhost:5174
